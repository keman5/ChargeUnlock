{
	"name": "auv-pluglit",
	"main": "worker.mjs",
	"compatibility_date": "2026-10-01",
	"account_id": "1b141aa7926dded899acf369e71e8aa8",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"routes": [
		{
			"pattern": "auv.macseek.cc",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": false
	},
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	"ratelimits": [
		{
			"name": "FEEDBACK_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pluglit-feedback",
			"database_id": "e382f272-32a0-49a7-a8dc-11877823e76d"
		}
	]
}